<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <TextView
        android:id="@+id/tvLab"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="Lab 1"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvResponsive"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:background="#FFFFFF"
        android:text="Responsive Layout 1"
        android:textColor="#000000"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvLab"
        app:layout_constraintBottom_toTopOf="@id/rowColors"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.25" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rowColors"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvResponsive"
        app:layout_constraintBottom_toTopOf="@id/tvAndroid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.12">

        <TextView
            android:id="@+id/tvThis"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:background="#FF0000"
            android:text="This"
            android:textColor="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvIs"
            app:layout_constraintHorizontal_weight="1" />

        <TextView
            android:id="@+id/tvIs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:background="#0000FF"
            android:text="is"
            android:textColor="#FFFFFF"
            app:layout_constraintStart_toEndOf="@id/tvThis"
            app:layout_constraintEnd_toStartOf="@id/tvMy"
            app:layout_constraintHorizontal_weight="1" />

        <TextView
            android:id="@+id/tvMy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:background="#7E57C2"
            android:text="my"
            android:textColor="#FFFFFF"
            app:layout_constraintStart_toEndOf="@id/tvIs"
            app:layout_constraintEnd_toStartOf="@id/tvFirst"
            app:layout_constraintHorizontal_weight="1" />

        <TextView
            android:id="@+id/tvFirst"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:background="#FFFF00"
            android:text="first"
            android:textColor="#000000"
            app:layout_constraintStart_toEndOf="@id/tvMy"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvAndroid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:text="Android Application"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/rowColors"
        app:layout_constraintBottom_toTopOf="@id/rowButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rowButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnChange"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#7E57C2"
            android:text="Change"
            android:textColor="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnCancel"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_weight="1" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#7E57C2"
            android:text="Cancel"
            android:textColor="#FFFFFF"
            app:layout_constraintStart_toEndOf="@id/btnChange"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_weight="1" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>